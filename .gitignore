# environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# raw downloads are re-fetched by `oncogene download` (checksums in provenance.json)
data/raw/*
!data/raw/.gitkeep
!data/raw/provenance.json

# The processed matrix (15 MB, derived from public GEO data) IS committed so the dashboard
# runs from a fresh clone and on Streamlit Cloud; `oncogene preprocess` regenerates it.

# binary model artifacts are regenerated by `oncogene train` (model cards are kept)
artifacts/models/*.joblib
artifacts/reports/pipeline.log
artifacts/reports/train_console.txt

# demo video is large; regenerate with scripts/capture_screenshots.py --video
docs/demo/*.webm

.DS_Store
Thumbs.db
